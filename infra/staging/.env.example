# Staging environment template. Copy to `.env` (gitignored) and replace every CHANGE_ME.
# NEVER commit real secrets. App images are pulled from GHCR (signed on main).

IMAGE_REGISTRY=ghcr.io/yunecque/ai_dev_project
IMAGE_TAG=main

POSTGRES_USER=sdlc
POSTGRES_DB=requests
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://sdlc:CHANGE_ME@postgres:5432/requests

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
OIDC_ISSUER=http://keycloak:8080/realms/sdlc
OIDC_CLIENT_ID=sdlc-gateway

GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
