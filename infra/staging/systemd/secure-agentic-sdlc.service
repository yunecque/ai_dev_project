[Unit]
Description=Secure Agentic SDLC staging stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/secure-agentic-sdlc/infra/staging
Environment=ENV_FILE=/etc/secure-agentic-sdlc/staging.env
ExecStart=/usr/bin/docker compose --env-file ${ENV_FILE} up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file ${ENV_FILE} down
TimeoutStartSec=0
Restart=on-failure

[Install]
WantedBy=multi-user.target
