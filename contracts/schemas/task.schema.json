{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-agentic-sdlc.local/schemas/task.schema.json",
  "title": "Task (vertical slice)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "id", "created_at", "created_by", "feature_id", "plan_id", "status", "title", "requirement_ids", "control_ids", "contract_changes", "code_changes", "tests"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_type": { "type": "string", "const": "task" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "created_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "created_by": { "$ref": "common.schema.json#/$defs/actor" },
    "run_id": { "$ref": "common.schema.json#/$defs/runId" },
    "links": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/link" } },
    "feature_id": { "$ref": "common.schema.json#/$defs/id" },
    "plan_id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "type": "string", "enum": ["todo", "in_progress", "implemented", "in_review", "done", "blocked"] },
    "title": { "type": "string", "minLength": 1 },
    "requirement_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "control_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "contract_changes": { "type": "array", "items": { "type": "string" } },
    "code_changes": { "type": "array", "items": { "type": "string" } },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "requirement_id"],
        "properties": {
          "kind": { "type": "string", "enum": ["unit", "api_acceptance", "authorization", "grpc_contract", "event_contract", "integration", "security", "negative_pipeline", "e2e_smoke"] },
          "ref": { "type": "string" },
          "requirement_id": { "$ref": "common.schema.json#/$defs/id" },
          "control_id": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "branch": { "type": "string", "pattern": "^feature/FEAT-[0-9]{4}-TASK-[0-9]{4}-[a-z0-9-]+$" }
  }
}
