{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-agentic-sdlc.local/schemas/plan.schema.json",
  "title": "Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "id", "created_at", "created_by", "feature_id", "status", "slices"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_type": { "type": "string", "const": "plan" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "created_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "created_by": { "$ref": "common.schema.json#/$defs/actor" },
    "run_id": { "$ref": "common.schema.json#/$defs/runId" },
    "links": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/link" } },
    "feature_id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "type": "string", "enum": ["draft", "approved", "superseded"] },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "title", "requirement_ids", "control_ids"],
        "properties": {
          "slice_id": { "type": "string" },
          "title": { "type": "string" },
          "requirement_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "control_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "approval": { "$ref": "common.schema.json#/$defs/approval" }
  }
}
