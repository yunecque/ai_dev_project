{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-agentic-sdlc.local/schemas/baseline.schema.json",
  "title": "Architecture Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline_id", "version", "status", "profile", "approved_by", "approved_at", "languages", "communication", "identity", "policy_engine", "containerization", "observability", "security_tooling", "deployment", "supply_chain_controls_always_required"],
  "properties": {
    "$schema": { "type": "string" },
    "baseline_id": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "status": { "type": "string", "enum": ["draft", "approved", "superseded"] },
    "profile": { "type": "string", "enum": ["strict", "personal-project"] },
    "approved_by": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/actorRole" } },
    "approved_at": { "type": "string", "format": "date" },
    "purpose": { "type": "string" },
    "languages": { "type": "object" },
    "communication": { "type": "object" },
    "identity": { "type": "object" },
    "policy_engine": { "type": "object" },
    "containerization": { "type": "object" },
    "observability": { "type": "object" },
    "security_tooling": { "type": "object" },
    "deployment": { "type": "object" },
    "supply_chain_controls_always_required": {
      "type": "array",
      "items": { "type": "string", "enum": ["signing", "sbom", "secret-scanning"] }
    }
  }
}
