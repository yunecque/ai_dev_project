{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-agentic-sdlc.local/schemas/evidence-bundle.schema.json",
  "title": "Evidence Bundle",
  "description": "Content-addressed manifest of release evidence gathered for the pre-deployment gate (M3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "id",
    "created_at",
    "actor",
    "run_id",
    "image",
    "candidate_digest",
    "bundle_digest",
    "items"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_type": { "type": "string", "const": "evidence-bundle" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "created_at": { "$ref": "common.schema.json#/$defs/isoDateTime" },
    "actor": { "$ref": "common.schema.json#/$defs/actor" },
    "run_id": { "$ref": "common.schema.json#/$defs/runId" },
    "image": { "type": "string", "minLength": 1 },
    "candidate_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "bundle_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "digest"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["signature", "sbom", "provenance", "policy-decision", "approval"]
          },
          "ref": { "type": "string" },
          "digest": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "policy_decision_ref": { "type": "string" },
    "links": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/link" } }
  }
}
