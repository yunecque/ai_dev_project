# Normalize line endings for a cross-platform repo (Windows host + WSL/Linux CI).
* text=auto eol=lf

# Shell / container scripts must stay LF.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-native tooling keeps CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary-ish assets: never touch.
*.png binary
*.jpg binary
*.pdf binary